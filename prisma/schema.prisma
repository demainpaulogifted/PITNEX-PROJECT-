generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// PITNEX DATABASE
// ============================================================
//
// IMPORTANT:
// All PITNEX tables use the "pitnex_" prefix.
//
// This keeps the PITNEX data clearly separated from the
// existing THE INDEX tables in the same Supabase project.
// ============================================================


// ============================================================
// USER PROFILE
// ============================================================

model PitnexProfile {
  id            String   @id @db.Uuid
  email         String?  @unique
  fullName      String?
  username      String?  @unique
  phone         String?
  role          PitnexRole @default(USER)
  accountStatus AccountStatus @default(ACTIVE)

  upgradedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  wallet        PitnexWallet?
  transactions  PitnexWalletTransaction[]
  withdrawals   PitnexWithdrawal[]

  @@map("pitnex_profiles")
}


// ============================================================
// ROLES
// ============================================================

enum PitnexRole {
  USER
  ADMIN
  SUPER_ADMIN

  @@map("pitnex_role")
}


// ============================================================
// ACCOUNT STATUS
// ============================================================

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED

  @@map("pitnex_account_status")
}


// ============================================================
// WALLET
// ============================================================

model PitnexWallet {
  id                    String   @id @default(uuid()) @db.Uuid

  userId                String   @unique @db.Uuid

  balanceKobo           BigInt   @default(0)
  lifetimeEarnedKobo    BigInt   @default(0)
  lifetimeWithdrawnKobo BigInt   @default(0)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                  PitnexProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions          PitnexWalletTransaction[]

  @@map("pitnex_wallets")
}


// ============================================================
// WALLET TRANSACTIONS
// ============================================================

model PitnexWalletTransaction {
  id             String   @id @default(uuid()) @db.Uuid

  userId         String   @db.Uuid
  walletId       String   @db.Uuid

  type           WalletTransactionType
  status         WalletTransactionStatus @default(COMPLETED)

  amountKobo     BigInt

  reference      String   @unique

  description    String?

  metadata       Json?

  createdAt      DateTime @default(now())

  user           PitnexProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  wallet         PitnexWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([walletId])
  @@index([type])
  @@index([status])
  @@index([createdAt])

  @@map("pitnex_wallet_transactions")
}


// ============================================================
// TRANSACTION TYPES
// ============================================================

enum WalletTransactionType {
  TASK_REWARD
  DAILY_CHECKIN
  REFERRAL_REWARD
  BONUS
  MANUAL_CREDIT

  WITHDRAWAL
  WITHDRAWAL_REVERSAL

  PACKAGE_PAYMENT
  ACCOUNT_UPGRADE

  REFUND
  MANUAL_DEBIT

  @@map("pitnex_wallet_transaction_type")
}


// ============================================================
// TRANSACTION STATUS
// ============================================================

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED

  @@map("pitnex_wallet_transaction_status")
}


// ============================================================
// WITHDRAWALS
// ============================================================

model PitnexWithdrawal {
  id            String    @id @default(uuid()) @db.Uuid

  userId        String    @db.Uuid

  reference     String    @unique

  amountKobo    BigInt

  status        WithdrawalStatus @default(PENDING)

  bankName      String
  accountNumber String
  accountName   String?
  bankCode      String?

  requestedAt   DateTime  @default(now())
  processedAt   DateTime?

  adminNote     String?

  user          PitnexProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([requestedAt])

  @@map("pitnex_withdrawals")
}


// ============================================================
// WITHDRAWAL STATUS
// ============================================================

enum WithdrawalStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  REJECTED
  CANCELLED

  @@map("pitnex_withdrawal_status")
}


// ============================================================
// PLATFORM SETTINGS
// ============================================================

model PitnexSetting {
  id          String   @id @default(uuid()) @db.Uuid

  key         String   @unique

  value       Json

  description String?

  updatedAt   DateTime @updatedAt

  @@map("pitnex_settings")
}